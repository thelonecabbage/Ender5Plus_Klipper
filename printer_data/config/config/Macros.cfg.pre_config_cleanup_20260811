[gcode_macro G29]	
gcode:
  G28
  bed_mesh_calibrate
  G1 X0 Y0 Z10 F4200





[gcode_macro LOAD_FILAMENT]
variable_load_distance: 55
variable_purge_distance:  50
gcode:
    {% set speed = params.SPEED|default(50) %}
    {% set extrude_temp = params.EXTRUDE_TEMP|default(200)|int %}
    {% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
    SAVE_GCODE_STATE NAME=load_state
    {% if printer.extruder.temperature < extrude_temp %}
      M104 S{extrude_temp}            ; set extruder temperature
      M109 S{extrude_temp}            ; wait for extruder temperature
    {% endif %}
    G91
    G92 E0
    G1 E{load_distance} F{max_velocity} # fast-load
    G1 E{purge_distance} F{speed} # purge
    RESTORE_GCODE_STATE NAME=load_state
    M104 S0            ; reset extruder temperature

[gcode_macro UNLOAD_FILAMENT]
variable_unload_distance:  70
variable_purge_distance:  40
gcode:
    {% set speed = params.SPEED|default(50) %}
    {% set extrude_temp = params.EXTRUDE_TEMP|default(200)|int %}
    {% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
    SAVE_GCODE_STATE NAME=unload_state
    {% if printer.extruder.temperature < extrude_temp %}
      M104 S{extrude_temp}            ; set extruder temperature
      M109 S{extrude_temp}            ; wait for extruder temperature
    {% endif %}
    G91
    G92 E0
    G1 E-{purge_distance} F{speed} # purge
    G1 E-{unload_distance}  F{max_velocity} # fast-unload
    RESTORE_GCODE_STATE NAME=unload_state
    M104 S0            ; reset extruder temperature

# ----------------------------
# KAMP-friendly START_PRINT
# ZeroG+ Mercury 1.1 (370x377)
# ----------------------------
[gcode_macro START_PRINT]
description: "Start print w/ KAMP adaptive mesh + LINE_PURGE"
gcode:
  {% set BED      = params.BED|default(40)|float %}
  {% set EXTRUDER = params.EXTRUDER|default(210)|float %}
  {% set PREHEAT  = params.PREHEAT|default(150)|float %}
  {% set PARK_X   = params.PARK_X|default(70)|float %}
  {% set PARK_Y   = params.PARK_Y|default(40)|float %}
  {% set Z_LIFT   = params.Z_LIFT|default(50)|float %}

  # Safety clamps for your bed size (370x377)
  {% set PARK_X = [0.0, [PARK_X, 377.0]|min]|max %}
  {% set PARK_Y = [0.0, [PARK_Y, 370.0]|min]|max %}

  # Modes
  G90                          ; absolute XYZ
  M83                          ; relative E

  # Heat staging (bed to target, nozzle to preheat to reduce ooze)
  M140 S{BED}                  ; start bed heat (no wait)
  M104 S{PREHEAT}              ; start nozzle preheat (no wait)
  G4 S30                       ; partial warmup window

  # Home and stabilize bed
  G28
  M190 S{BED}                  ; wait for bed

  # KAMP adaptive mesh:
  # If KAMP is installed/configured, it typically overrides BED_MESH_CALIBRATE
  # and uses exclude_object polygons from Moonraker.
  BED_MESH_CLEAR
  BED_MESH_CALIBRATE

  # Move to a sane spot, then finish heating
  G1 Z{Z_LIFT} F240
  G1 X{PARK_X} Y{PARK_Y} F6000

  M104 S{EXTRUDER}             ; final nozzle temp (no wait)
  M109 S{EXTRUDER}             ; wait for nozzle

  # KAMP adaptive purge (your config includes LINE_PURGE.cfg)
  LINE_PURGE
